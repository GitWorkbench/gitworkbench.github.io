---
import { NAVIGATION, SITE } from '../data/site';
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label={`${SITE.name} — home`}>
      <span aria-hidden="true">git-workbench</span><span class="brand-cursor" aria-hidden="true"></span>
    </a>

    <nav id="site-navigation" class="site-nav" aria-label="Main navigation">
      <ul data-nav>
        {
          NAVIGATION.map((item) => (
            <li>
              <a href={item.href} aria-current={!item.href.includes('#') && Astro.url.pathname.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a class="button button-outline button-sm" href={NAVIGATION.at(-1)?.href}>Get the app</a>
      <button
        class="mobile-menu-toggle"
        type="button"
        data-menu-toggle
        aria-controls="site-navigation"
        aria-expanded="false"
        aria-label="Open navigation menu"
      >
        <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M2 5h14M2 9h14M2 13h14" />
        </svg>
      </button>
    </div>
  </div>
  <div class="scroll-progress" aria-hidden="true" data-progress></div>
</header>

<noscript>
  <div class="wrap noscript-notice" role="note">
    JavaScript is off: downloads and FAQs still work. Enable JavaScript for interactive previews
    and live release updates.
  </div>
</noscript>
