---
/**
 * Decorative strata band for the hero: horizontal commit lanes flowing
 * left to right — geological strata, drawn as a git river. Full-bleed,
 * sits beneath the hero copy. Pure SVG, aria-hidden.
 */
---
<svg viewBox="0 0 1440 170" fill="none" aria-hidden="true">
  <!-- sediment guides -->
  <g stroke="#141a22" stroke-width="1">
    <path d="M0 30h1440" />
    <path d="M0 56h1440" opacity="0.6" />
    <path d="M0 118h1440" opacity="0.6" />
    <path d="M0 144h1440" />
  </g>

  <!-- main river (cyan), spans the full width -->
  <path d="M-12 88H1452" stroke="#38bdf8" stroke-width="2.6" />
  <!-- violet tributary merges in -->
  <path d="M-12 132 C 240 132, 520 132, 754 90" stroke="#a78bfa" stroke-width="2.3" />
  <!-- green tributary merges in further right -->
  <path d="M-12 42 C 300 42, 660 42, 1034 88" stroke="#34d399" stroke-width="2.3" />
  <!-- red side branch diverges and goes stale (dashed tail) -->
  <path d="M984 88 C 1032 92, 1052 122, 1108 138 C 1158 152, 1240 152, 1288 148" stroke="#f87171" stroke-width="2" />
  <path d="M1288 148 C 1320 146, 1350 144, 1376 142" stroke="#f87171" stroke-width="2" stroke-dasharray="5 8" opacity="0.7" />
  <!-- amber short-lived branch -->
  <path d="M150 140 H 452" stroke="#fbbf24" stroke-width="2" stroke-dasharray="7 9" opacity="0.85" />

  <!-- nodes on main -->
  <circle cx="180" cy="88" r="5" fill="#38bdf8" />
  <circle cx="420" cy="88" r="5" fill="#38bdf8" />
  <g>
    <circle cx="760" cy="88" r="6.4" fill="#38bdf8" />
    <circle cx="760" cy="88" r="15" stroke="#38bdf8" stroke-width="1.3" opacity="0.4" />
  </g>
  <g>
    <circle cx="1040" cy="88" r="6.4" fill="#38bdf8" />
    <circle cx="1040" cy="88" r="15" stroke="#38bdf8" stroke-width="1.3" opacity="0.4" />
  </g>
  <circle cx="1240" cy="88" r="5" fill="#38bdf8" />
  <!-- tributary nodes -->
  <circle cx="150" cy="132" r="4.6" fill="#a78bfa" />
  <circle cx="430" cy="132" r="4.6" fill="#a78bfa" />
  <circle cx="640" cy="42" r="4.4" fill="#34d399" />
  <circle cx="880" cy="42" r="4.4" fill="#34d399" />
  <circle cx="150" cy="140" r="4" fill="#fbbf24" />
  <circle cx="452" cy="140" r="4" fill="#fbbf24" />
  <circle cx="1322" cy="146" r="4.2" fill="#f87171" />

  <!-- floating refs -->
  <g font-family="ui-monospace, monospace" font-size="11.5" font-weight="600">
    <g>
      <rect x="1378" y="61" width="56" height="21" rx="10.5" fill="#1a1d24" stroke="#2d3340" />
      <text x="1406" y="75.5" text-anchor="middle" fill="#38bdf8">HEAD</text>
    </g>
    <g>
      <rect x="212" y="60" width="64" height="21" rx="10.5" fill="#1a1d24" stroke="#2d3340" />
      <text x="244" y="74.5" text-anchor="middle" fill="#94a3b8">v1.3.4</text>
    </g>
    <g>
      <rect x="492" y="106" width="92" height="21" rx="10.5" fill="#1a1d24" stroke="#2d3340" />
      <text x="538" y="120.5" text-anchor="middle" fill="#a78bfa">feat/stack</text>
    </g>
    <g>
      <rect x="1168" y="104" width="74" height="21" rx="10.5" fill="#1a1d24" stroke="#2d3340" />
      <text x="1205" y="118.5" text-anchor="middle" fill="#94a3b8">stash/1</text>
    </g>
  </g>

  <!-- hash dust -->
  <g font-family="ui-monospace, monospace" font-size="10" fill="#5c6a7e">
    <text x="60" y="80" opacity="0.8">9a4f21c</text>
    <text x="330" y="80" opacity="0.65">b17e4d0</text>
    <text x="560" y="80" opacity="0.65">3c8fa92</text>
    <text x="860" y="80" opacity="0.6">e02b517</text>
    <text x="1100" y="80" opacity="0.6">5fa1d38</text>
    <text x="700" y="128" opacity="0.5">c73ea01</text>
  </g>
</svg>
