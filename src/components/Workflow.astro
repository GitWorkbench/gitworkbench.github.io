---
import { SHORTCUTS, WORKFLOWS } from '../data/site';
---

<section id="how-it-works" class="section">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="kicker"><span class="kicker-hash">f18a2b9</span> // reflog</p>
      <h2>Four moves, read<br />like a reflog.</h2>
      <p class="section-lead">
        The safe path is built in: choices are reversible, destructive actions snapshot first, and
        rewrites stay local until you push.
      </p>
    </header>

    <ol class="reflog">
      {
        WORKFLOWS.map((flow, index) => {
          const ref = 3 - index;
          return (
            <li class="reflog-row" data-reveal>
              <span class="reflog-ref">
                {`HEAD@{${ref}}`}
                <small>step {flow.step}</small>
              </span>
              <div>
                <h3>{flow.title}</h3>
                <p>{flow.description}</p>
              </div>
            </li>
          );
        })
      }
    </ol>

    <div class="section-head" style="margin-top: 3.4rem;" data-reveal>
      <p class="kicker"><span class="kicker-hash">4c2d5e8</span> // keyboard-first</p>
      <h2>Everywhere without<br />a mouse.</h2>
    </div>
    <div class="shortcut-grid" data-reveal data-shortcuts>
      {
        SHORTCUTS.map((shortcut) => (
          <div class="shortcut">
            <span class="keys">
              {shortcut.keys.map((key) => (
                <kbd class="key">{key}</kbd>
              ))}
            </span>
            <span>{shortcut.label}</span>
          </div>
        ))
      }
      <div class="shortcut">
        <span class="keys"><kbd class="key" data-mod-key>Ctrl</kbd><kbd class="key">`</kbd></span>
        <span>Open the terminal drawer</span>
      </div>
    </div>
    <p class="install-note" data-shortcut-note hidden>
      Shortcuts shown for macOS use <strong>⌘</strong> where the sheet lists
      <kbd class="key" data-mod-key>Ctrl</kbd>.
    </p>
  </div>
</section>
