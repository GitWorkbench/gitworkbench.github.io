---
import { SITE, URLS } from '../data/site';
---

<section class="hero wrap">
  <p class="eyebrow"><span class="status-dot"></span> OPEN-SOURCE DESKTOP GIT CLIENT</p>
  <h1>See the whole story.<br class="desktop-break" />{' '}<span>Work from one Git workspace.</span></h1>
  <p class="hero-description">
    Follow branches in a visual commit graph, inspect changes before they land, and move from local
    work to code review without losing context.
  </p>
  <div class="hero-actions">
    <a class="button button-primary" href="/#download">
      Download {SITE.name} <span aria-hidden="true">↓</span>
    </a>
    <a class="button button-secondary" href="/#workspace">See the app <span aria-hidden="true">↘</span></a>
  </div>
  <p class="hero-note">
    Free &amp; open source <span>·</span> Linux, macOS &amp; Windows <span>·</span> Uses your system Git
  </p>
  <p class="hero-secondary-link">
    <a href={URLS.repository}>Explore the source on GitHub <span aria-hidden="true">↗</span></a>
  </p>
</section>
