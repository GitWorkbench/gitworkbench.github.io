---
import AppMock from './AppMock.astro';
import { HERO, HERO_STATS, INSTALL_COMMAND, URLS } from '../data/site';

const commandUrl = INSTALL_COMMAND.slice(INSTALL_COMMAND.indexOf('https://'));
---

<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow" data-reveal>{HERO.eyebrow}</p>
      <h1 data-reveal>
        Complex Git history, rendered as <span class="accent-glow">clear strata</span>.
      </h1>
      <p class="lead" data-reveal>{HERO.lead}</p>

      <div class="hero-actions" data-reveal>
        <a class="button button-primary" href={URLS.releases} data-download="">
          Get the latest version
          <svg width="15" height="15" viewBox="0 0 15 15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7.5 1.5v8m0 0l3.5-3.5M7.5 9.5L4 6m-2.5 6.5h12" />
          </svg>
        </a>
        <a class="button button-outline" href={URLS.repository}>
          Browse the source
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 2.5H2.5v9h9V9M8.5 1.5H12.5V5.5M12.5 1.5l-5 5" />
          </svg>
        </a>
      </div>

      <div class="hero-install" data-reveal>
        <span class="install-label" id="hero-install-label">Install on Linux, one line</span>
        <div class="quick-install-command">
          <code aria-labelledby="hero-install-label" tabindex="0" aria-label="Install command, horizontally scrollable">curl -fsSL <span>{commandUrl}</span> | bash</code>
          <button class="copy-btn" type="button" data-copy={INSTALL_COMMAND} aria-label="Copy the Linux install command">
            <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="4.6" y="4.6" width="8" height="8" rx="1.6" />
              <path d="M9.4 4.6V3a1.4 1.4 0 0 0-1.4-1.4H3A1.4 1.4 0 0 0 1.6 3v5A1.4 1.4 0 0 0 3 9.4h1.6" />
            </svg>
            <span data-copy-label>Copy</span>
          </button>
        </div>
        <p class="install-note">Debian, RPM, Arch, and an AppImage fallback · SHA-512 verified.</p>
      </div>

      <ul class="hero-stats" data-reveal>
        {
          HERO_STATS.map((stat) => (
            <li>
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-visual" data-reveal>
      <AppMock />
    </div>
  </div>
</section>
