---
import { STEPS, URLS } from '../data/site';
---

<section id="how-it-works" class="getting-started section wrap" aria-labelledby="how-title">
  <div class="section-heading">
    <div>
      <p class="eyebrow">FROM FIRST LAUNCH TO FIRST REVIEW</p>
      <h2 id="how-title">How to use Git Workbench.</h2>
    </div>
    <a class="text-link" href={URLS.docs}>
      Read the complete documentation <span aria-hidden="true">↗</span>
    </a>
  </div>
  <ol class="steps">
    {
      STEPS.map((step, index) => (
        <li>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </li>
      ))
    }
  </ol>
  <div class="getting-started-note">
    <strong>New to Git?</strong>
    <span>
      Open Explore Git Workbench in the app for 28 step-by-step guides covering commits, branches,
      merges, worktrees, recovery, and more.
    </span>
    <a href={URLS.firstRun}>Learn about first-run setup <span aria-hidden="true">↗</span></a>
  </div>
</section>
