---
import { NAVIGATION, SITE, TRADEMARK_NOTICE, URLS } from '../data/site';
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/" aria-label={`${SITE.name} — home`}>
          <span aria-hidden="true">git-workbench</span><span class="brand-cursor" aria-hidden="true"></span>
        </a>
        <p>
          Visual commit strata and an effortless git workflow — free and open source for Linux,
          macOS, and Windows.
        </p>
        <a class="button button-outline button-sm" href="/download/">Get the latest release</a>
      </div>

      <nav aria-label="Site sections">
        <h2 class="footer-heading">Site</h2>
        <ul class="footer-list">
          <li><a href="/about/">About Git Workbench</a></li>
          {
            NAVIGATION.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Project links">
        <h2 class="footer-heading">Project</h2>
        <ul class="footer-list">
          <li><a href={URLS.repository}>Source repository</a></li>
          <li><a href={URLS.releases}>Releases</a></li>
          <li><a href={URLS.issues}>Issue tracker</a></li>
          <li><a href={URLS.license}>License (MIT)</a></li>
        </ul>
      </nav>

      <nav aria-label="Documentation links">
        <h2 class="footer-heading">Guides</h2>
        <ul class="footer-list">
          <li><a href="/guides/getting-started/">Getting started</a></li>
          <li><a href="/guides/linux-installation/">Linux installation</a></li>
          <li><a href="/guides/advanced-git-workflows/">Advanced Git workflows</a></li>
          <li><a href="/guides/build-from-source/">Build from source</a></li>
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <span>{SITE.author.name} · MIT license · <a href="/privacy/">Website privacy</a> · <a href="/sitemap.xml">Sitemap</a></span>
      <span>
        built with <a href="https://astro.build">astro</a> · site source:{' '}
        <a href="https://github.com/GitWorkbench/gitworkbench.github.io">gitworkbench.github.io</a>
      </span>
    </div>
    <p class="footer-trademark">
      {TRADEMARK_NOTICE.nameUsage} {TRADEMARK_NOTICE.git} {TRADEMARK_NOTICE.independence}
      <a href="/about/#trademarks">Git trademark notice</a>.
    </p>
  </div>
</footer>
