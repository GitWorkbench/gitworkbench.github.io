---
import { FEATURES } from '../data/site';

const lane = ['#38bdf8', '#a78bfa', '#34d399', '#fbbf24'];
const hashes = ['a1f3c2d', 'b7e94f0', 'c3d8a15', 'd92b6e4', 'e05f73c', 'f18a2b9', '4c2d5e8', '7e9f1a3', '08b4c62'];
---

<section id="features" class="section">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="kicker"><span class="kicker-hash">a1f3c2d</span> // features</p>
      <h2>Every feature is<br />a commit in the log.</h2>
      <p class="section-lead">
        Nine commits shaped this workbench. Read the log the way you read the app: lanes branch,
        merge, and keep going.
      </p>
    </header>

    <ol class="commit-log">
      {
        FEATURES.map((feature, index) => (
          <li class="commit-row" style={`--lane:${lane[index % lane.length]}`} data-reveal>
            <span class="commit-dot" aria-hidden="true"></span>
            <span class="commit-hash" aria-hidden="true">{hashes[index]}</span>
            <div class="commit-body">
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
              <p class="commit-detail">{feature.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
