---
import { FEATURES } from '../data/site';

const lane = ['#38bdf8', '#a78bfa', '#34d399', '#fbbf24'];
const hashes = ['a1f3c2d', 'b7e94f0', 'c3d8a15', 'd92b6e4', 'e05f73c', 'f18a2b9', '4c2d5e8', '7e9f1a3', '08b4c62', '31c7d64', '9b50e2f', '6d81f47', '2ae8d5c', 'c71b6e3'];
const links = ['/features/commit-graph/', '/features/commit-graph/', '/features/commit-graph/#milestone-celebrations', '/features/staging-and-diffs/', '/features/merge-conflicts/', '/features/pull-request-reviews/', '/features/pull-request-reviews/', '/#themes', '/guides/getting-started/', '/features/restore-points/', '/features/ai-assistance/', '/features/commit-graph/', '/guides/', '/guides/advanced-git-workflows/'];
---

<section id="features" class="section">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="kicker"><span class="kicker-hash">a1f3c2d</span> // features</p>
      <h2>Your Git workflow.<br />All in one workbench.</h2>
      <p class="section-lead">
        Read branch history, review a patch, resolve a conflict, and recover a change.
        Explore the tools behind each part of your day.
      </p>
    </header>

    <ol class="commit-log">
      {
        FEATURES.map((feature, index) => (
          <li class="commit-row" style={`--lane:${lane[index % lane.length]}`} data-reveal>
            <span class="commit-dot" aria-hidden="true"></span>
            <span class="commit-hash" aria-hidden="true">{hashes[index]}</span>
            <div class="commit-body">
              <h3><a href={links[index]}>{feature.title} <span aria-hidden="true">↗</span></a></h3>
              <p>{feature.description}</p>
              <p class="commit-detail">{feature.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="section-more"><a class="text-link" href="/features/">Explore the feature guides →</a><a class="text-link" href="/compare/">Compare Git clients →</a><a class="text-link" href="/guides/getting-started/">New here? Start with the setup guide →</a></p>
  </div>
</section>
