---
import { FEATURES } from '../data/site';

const glyphs = ['⑂', '±', '⋈', '⤴', '❐', '⧗', '✦', '◧', '⬡'];
---

<section id="features" class="section">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="kicker">// features</p>
      <h2>Built around the graph, wired to the rest of it.</h2>
      <p class="section-lead">
        Each tool opens into the same workspace, next to the strata that show you where you are.
      </p>
    </header>

    <div class="bento">
      {
        FEATURES.map((feature, index) => (
          <article class={`bento-card${feature.size === 'wide' ? ' is-wide' : ''}`} data-reveal>
            <span class="bento-glyph" aria-hidden="true">{glyphs[index]}</span>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
            <p class="bento-detail">{feature.detail}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
