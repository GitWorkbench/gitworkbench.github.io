---
import { URLS, WHY_POINTS } from '../data/site';
---

<section class="why-section section wrap" aria-labelledby="why-title">
  <div class="why-copy">
    <p class="eyebrow">WHY GIT WORKBENCH</p>
    <h2 id="why-title">Git makes more sense when you can see the connections.</h2>
    <p>
      Many Git clients put history, file changes, terminals, and code review in separate places.
      Git Workbench brings those parts together around a visual commit graph, so you can trace a
      change from branch to patch to review.
    </p>
    <a class="text-link" href={URLS.repository}>
      Explore the open-source project <span aria-hidden="true">↗</span>
    </a>
  </div>
  <div class="why-points">
    {
      WHY_POINTS.map((point, index) => (
        <article>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{point.title}</h3>
            <p>{point.description}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
