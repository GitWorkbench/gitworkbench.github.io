---
import { FAQ, URLS } from '../data/site';
---

<section id="faq" class="section">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="kicker"><span class="kicker-hash">e05f73c</span> // annotations</p>
      <h2>Questions reviewers<br />always ask.</h2>
    </header>
    <ul class="faq-list faq" data-reveal>
      {
        FAQ.map((entry) => (
          <li>
            <details>
              <summary>
                {entry.question}
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M6 3.5L10.5 8 6 12.5" />
                </svg>
              </summary>
              <p>{entry.answer}</p>
            </details>
          </li>
        ))
      }
    </ul>
    <p class="themes-note" data-reveal>
      Deeper questions are covered in the
      <a href={URLS.advanced}>advanced workflows guide</a> and the
      <a href={URLS.issues}>issue tracker</a>.
    </p>
  </div>
</section>
