---
import { FAQ, URLS } from '../data/site';
interface Props { standalone?: boolean }
const { standalone = false } = Astro.props;
const Heading = standalone ? 'h1' : 'h2';
---

<section id="faq" class="section" aria-labelledby="faq-heading">
  <div class="wrap faq-layout">
    <div class="faq-intro" data-reveal>
      <header class="section-head">
        <p class="kicker"><span class="kicker-hash">e05f73c</span> // good to know</p>
        <Heading id="faq-heading">{standalone ? <>Git Workbench.<br />Your questions, answered.</> : <>A little clarity.<br />Before you commit.</>}</Heading>
        <p class="section-lead">The essentials on getting started, your existing setup, and keeping your code yours.</p>
      </header>
      <aside class="faq-help">
        <span class="faq-help-icon" aria-hidden="true">?</span>
        <h3>Still have a question?</h3>
        <p>Go a little deeper in the docs, or start a conversation on GitHub.</p>
        <a href={URLS.advanced}>Explore the guide <span aria-hidden="true">↗</span></a>
        <a href={URLS.issues}>Ask on GitHub <span aria-hidden="true">↗</span></a>
      </aside>
    </div>
    <ul class="faq-list faq" data-reveal>
      {FAQ.map((entry, index) => (
        <li>
          <details name="workbench-faq" open={index === 0}>
            <summary>
              <span class="faq-question">{entry.question}</span>
              <span class="faq-toggle" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M3 8h10" /><path class="faq-plus" d="M8 3v10" /></svg></span>
            </summary>
            <div class="faq-answer"><p>{entry.answer}</p></div>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>
