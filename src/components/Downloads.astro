---
import { URLS } from '../data/site';
---

<section id="download" class="download-section section" aria-labelledby="download-title">
  <div class="wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow">FREE DOWNLOADS FOR YOUR DESKTOP</p>
        <h2 id="download-title">Pick your platform.</h2>
      </div>
      <div class="release-summary">
        <span class="release-badge" id="release-version">GitHub Releases</span>
        <a id="release-notes" class="text-link" href={URLS.releases}>Release notes ↗</a>
      </div>
    </div>
    <p id="release-status" class="release-status" role="status" aria-live="polite">
      Downloads open the latest public release on GitHub.
    </p>
    <div class="download-grid">
      <article class="download-card" data-platform="linux">
        <div class="platform-heading">
          <span class="os-symbol" aria-hidden="true">◈</span>
          <div>
            <h3>Linux</h3>
            <p>Choose the package that fits.</p>
          </div>
          <span class="detected-label">Your platform</span>
        </div>
        <label class="architecture" for="linux-arch">
          Architecture
          <select id="linux-arch">
            <option value="x64">Intel / AMD 64-bit</option>
            <option value="arm64">ARM 64-bit</option>
          </select>
        </label>
        <a class="button button-primary full" data-download="AppImage" href={URLS.releases}>
          <span data-download-label>AppImage</span>
          <span class="download-meta">
            <span data-download-size></span>
            <span aria-hidden="true">↓</span>
          </span>
        </a>
        <div class="package-links">
          <a data-download="deb" href={URLS.releases}>.deb ↗</a>
          <a data-download="rpm" href={URLS.releases}>.rpm ↗</a>
          <a data-download="pacman" href={URLS.releases}>.pkg.tar.zst ↗</a>
        </div>
        <p class="download-note">
          Debian / Ubuntu, Fedora / RPM, Arch, or a portable AppImage.
        </p>
      </article>
      <article class="download-card" data-platform="mac">
        <div class="platform-heading">
          <span class="os-symbol" aria-hidden="true">⌘</span>
          <div>
            <h3>macOS</h3>
            <p>Apple silicon &amp; Intel.</p>
          </div>
          <span class="detected-label">Your platform</span>
        </div>
        <p class="architecture plain">Universal build</p>
        <a class="button button-secondary full" data-download="dmg" href={URLS.releases}>
          <span data-download-label>Download for macOS</span>
          <span class="download-meta">
            <span data-download-size></span>
            <span aria-hidden="true">↓</span>
          </span>
        </a>
        <div class="package-links">
          <a data-download="zip" href={URLS.releases}>Prefer a ZIP? ↗</a>
        </div>
        <p class="download-note">
          macOS builds are unsigned. Installation and updates are manual; review the release
          instructions.
        </p>
      </article>
      <article class="download-card" data-platform="windows">
        <div class="platform-heading">
          <span class="os-symbol" aria-hidden="true">⊞</span>
          <div>
            <h3>Windows</h3>
            <p>A familiar desktop installer.</p>
          </div>
          <span class="detected-label">Your platform</span>
        </div>
        <p class="architecture plain">Intel / AMD 64-bit</p>
        <a class="button button-secondary full" data-download="exe" href={URLS.releases}>
          <span data-download-label>Download for Windows</span>
          <span class="download-meta">
            <span data-download-size></span>
            <span aria-hidden="true">↓</span>
          </span>
        </a>
        <div class="package-links">
          <span>NSIS installer · .exe</span>
        </div>
        <p class="download-note">Install system Git before opening your first repository.</p>
      </article>
    </div>
    <aside class="linux-quick-install" aria-labelledby="linux-quick-install-title">
      <div class="quick-install-copy">
        <p class="eyebrow">LINUX QUICK INSTALL</p>
        <h3 id="linux-quick-install-title">One command. Verified before install.</h3>
        <p>
          Automatically chooses the package for Debian-based, RPM-based, or Arch-based
          distributions. SHA-512 is checked before the system installer runs.
        </p>
      </div>
      <div class="quick-install-command">
        <pre tabindex="0"><code>curl -fsSL https://gitworkbench.github.io/install.sh | bash</code></pre>
        <a href={URLS.installerSource}>Review installer source ↗</a>
      </div>
      <p class="quick-install-note">
        The package manager asks for its normal confirmation. Other distributions get a per-user
        AppImage. Current official Linux builds are x86_64.
      </p>
    </aside>
    <p class="download-footer">
      All downloads come from the project's public GitHub Releases.{' '}
      <a href={URLS.releases}>Browse all releases ↗</a>
    </p>
  </div>
</section>
