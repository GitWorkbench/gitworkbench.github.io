---
import snapshot from '../data/release-snapshot.json';
import { assetUrl, findAsset, formatBytes, RELEASES_URL, type ReleaseAsset } from '../scripts/release';
import { DOWNLOAD_FORMATS, INSTALL_COMMAND, URLS } from '../data/site';

const linuxFormats = DOWNLOAD_FORMATS.filter((f) => ['AppImage', 'deb', 'rpm', 'pacman'].includes(f.format));
const macFormats = DOWNLOAD_FORMATS.filter((f) => ['dmg', 'zip'].includes(f.format));
const winFormats = DOWNLOAD_FORMATS.filter((f) => f.format === 'exe');

const platforms = [
  { id: 'linux', name: 'linux', meta: 'x86_64 · 4 formats', formats: linuxFormats, note: null },
  { id: 'mac', name: 'macos', meta: 'Intel + Apple silicon', formats: macFormats, note: 'Unsigned builds — install and update manually from the release page.' },
  { id: 'windows', name: 'windows', meta: 'NSIS installer', formats: winFormats, note: 'Supports in-app software updates.' },
] as const;

/**
 * The build bakes the latest stable release (scripts/snapshot-release.mjs,
 * run before every build) so every link below is a real, direct asset URL
 * even with JavaScript off or the GitHub API rate-limiting the visitor.
 * The client-side script only ever refreshes these values live.
 */
const tag = typeof snapshot.tag === 'string' && snapshot.tag.startsWith('v') ? snapshot.tag : '';
const assets = (Array.isArray(snapshot.assets) ? snapshot.assets : []) as ReleaseAsset[];
const releaseUrl = tag ? `${RELEASES_URL}/tag/${encodeURIComponent(tag)}` : RELEASES_URL;

const baked = platforms.map((platform) => ({
  ...platform,
  rows: platform.formats.map((format) => {
    const asset = findAsset(assets, format.format);
    return {
      format,
      url: (asset && assetUrl(asset)) ?? releaseUrl,
      size: asset ? formatBytes(asset.size) : '',
      available: Boolean(asset),
    };
  }),
}));
---

<section id="download" class="section">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="kicker"><span class="kicker-hash">7e9f1a3</span> // checkout</p>
      <h2>Get the binary.<br />Keep the package manager.</h2>
      <p class="section-lead">
        The one-liner below resolves your distribution and hands off to its package manager —
        checksums verified, prompt intact.
      </p>
    </header>

    <div class="install-terminal" data-reveal>
      <div class="terminal-head">
        <span class="mock-dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>bash — one-line install</span>
      </div>
      <div class="quick-install-command">
        <code id="terminal-command" tabindex="0" aria-label="Install command, horizontally scrollable"><span>curl -fsSL </span>{INSTALL_COMMAND.replace('curl -fsSL ', '').replace(' | bash', '')}<span> | bash</span></code>
        <button class="copy-btn" type="button" data-copy={INSTALL_COMMAND} aria-label="Copy the Linux install command">
          <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="4.6" y="4.6" width="8" height="8" rx="1.6" />
            <path d="M9.4 4.6V3a1.4 1.4 0 0 0-1.4-1.4H3A1.4 1.4 0 0 0 1.6 3v5A1.4 1.4 0 0 0 3 9.4h1.6" />
          </svg>
          <span data-copy-label>Copy</span>
        </button>
      </div>
    </div>

    {
      tag ? (
        <p
          id="release-status"
          class="release-status"
          role="status"
          aria-live="polite"
          data-release-snapshot={tag}
          data-state="ready"
          data-reveal
        >
          Links point directly to stable assets of <strong>{tag}</strong>, baked at build time — JavaScript
          refreshes them against the live release when GitHub allows.
        </p>
      ) : (
        <p id="release-status" class="release-status" role="status" aria-live="polite" data-state="fallback" data-reveal>
          Downloads link to the public release page. Live tracking is refreshed when JavaScript and the
          GitHub API both allow.
        </p>
      )
    }

    <div class="platform-list">
      {
        baked.map((platform) => (
          <article class="platform-row" data-platform={platform.id} data-reveal>
            <div class="platform-meta">
              <h3 class="platform-name">{platform.name}</h3>
              <small>{platform.meta}</small>
            </div>
            <div>
              <div class="asset-list">
                {platform.rows.map((row) => (
                  <a
                    class="asset-link"
                    href={row.url}
                    data-download={row.format.format}
                    data-available={row.available ? 'true' : undefined}
                    title={row.available && row.size ? `Download (${row.size}, verified SHA-512 by the installer)` : 'View this release for available builds'}
                  >
                    {row.format.label}
                    <span data-download-size>{row.size}</span>
                    <svg class="asset-spacer" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M4 10L10 4M5.5 4H10v4.5" />
                    </svg>
                  </a>
                ))}
              </div>
              {platform.note && <p class="install-note platform-note">{platform.note}</p>}
            </div>
          </article>
        ))
      }
    </div>

    <ul class="download-notes">
      <li>
        Latest release: <a id="release-version" href={releaseUrl}>{tag || 'view on GitHub'}</a>
      </li>
      <li><a id="release-notes" href={releaseUrl}>Release notes</a></li>
      <li><a href={URLS.installerSource}>Read the installer source</a></li>
    </ul>
  </div>
</section>
