---
import { DOWNLOAD_FORMATS, INSTALL_COMMAND, URLS } from '../data/site';

const linuxFormats = DOWNLOAD_FORMATS.filter((f) => ['AppImage', 'deb', 'rpm', 'pacman'].includes(f.format));
const macFormats = DOWNLOAD_FORMATS.filter((f) => ['dmg', 'zip'].includes(f.format));
const winFormats = DOWNLOAD_FORMATS.filter((f) => f.format === 'exe');
---

<section id="download" class="section">
  <div class="wrap">
    <header class="section-head download-hero" data-reveal>
      <p class="kicker">// install</p>
      <h2>Pick the package your system speaks.</h2>
      <p class="section-lead">
        The one-liner resolvers below always point at the latest public release. With JavaScript
        on, every card also links straight to the current release asset, size included.
      </p>
    </header>

    <div class="install-terminal" data-reveal>
      <div class="terminal-head">
        <span class="mock-dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>bash — one-line install</span>
      </div>
      <div class="quick-install-command">
        <code id="terminal-command" tabindex="0" aria-label="Install command, horizontally scrollable"><span>curl -fsSL </span>{INSTALL_COMMAND.replace('curl -fsSL ', '').replace(' | bash', '')}<span> | bash</span></code>
        <button class="copy-btn" type="button" data-copy={INSTALL_COMMAND} aria-label="Copy the Linux install command">
          <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="4.6" y="4.6" width="8" height="8" rx="1.6" />
            <path d="M9.4 4.6V3a1.4 1.4 0 0 0-1.4-1.4H3A1.4 1.4 0 0 0 1.6 3v5A1.4 1.4 0 0 0 3 9.4h1.6" />
          </svg>
          <span data-copy-label>Copy</span>
        </button>
      </div>
    </div>

    <p id="release-status" class="release-status" role="status" aria-live="polite" data-reveal>
      Download cards link to the public release page. Enable JavaScript for direct asset links.
    </p>

    <div class="download-grid">
      <article class="download-card" data-platform="linux" data-reveal>
        <h3>Linux <em>x86_64 · 4 formats</em></h3>
        <div class="asset-list">
          {
            linuxFormats.map((format) => (
              <a class="asset-link" href={URLS.releases} data-download={format.format}>
                {format.label}
                <span data-download-size />
                <svg class="asset-spacer" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 10L10 4M5.5 4H10v4.5" />
                </svg>
              </a>
            ))
          }
        </div>
      </article>

      <article class="download-card" data-platform="mac" data-reveal>
        <h3>macOS <em>Intel + Apple silicon</em></h3>
        <div class="asset-list">
          {
            macFormats.map((format) => (
              <a class="asset-link" href={URLS.releases} data-download={format.format}>
                {format.label}
                <span data-download-size />
                <svg class="asset-spacer" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 10L10 4M5.5 4H10v4.5" />
                </svg>
              </a>
            ))
          }
        </div>
        <p class="install-note">Universal builds are unsigned — install and update manually from the release page.</p>
      </article>

      <article class="download-card" data-platform="windows" data-reveal>
        <h3>Windows <em>NSIS · 10 (1809+)</em></h3>
        <div class="asset-list">
          {
            winFormats.map((format) => (
              <a class="asset-link" href={URLS.releases} data-download={format.format}>
                {format.label}
                <span data-download-size />
                <svg class="asset-spacer" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 10L10 4M5.5 4H10v4.5" />
                </svg>
              </a>
            ))
          }
        </div>
        <p class="install-note">Windows, plus every Linux format above, supports in-app software updates.</p>
      </article>
    </div>

    <ul class="download-notes">
      <li>
        Latest release:
        <a id="release-version" href={URLS.releases}>view on GitHub</a>
      </li>
      <li><a id="release-notes" href={URLS.releases}>Release notes</a></li>
      <li><a href={URLS.installerSource}>Read the installer source</a></li>
    </ul>
  </div>
</section>
