---
import { PLATFORMS, PROVIDERS } from '../data/site';
---

<section class="platform-strip wrap" aria-label="Supported platforms and providers">
  <span>A familiar workflow.<br /><strong>A wider view.</strong></span>
  <div>
    {PLATFORMS.map((platform) => <span>{platform}</span>)}
  </div>
  <span class="strip-divider" aria-hidden="true"></span>
  <div>
    {PROVIDERS.map((provider) => <span>{provider}</span>)}
  </div>
</section>
