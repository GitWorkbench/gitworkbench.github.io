---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---

<BaseLayout
  title={`Page not found — ${SITE.name}`}
  description="The page you are looking for does not exist. Return to the Git Workbench homepage to download the app or read the documentation."
  noindex
  canonicalPath="/404.html"
>
  <section class="not-found wrap">
    <code aria-hidden="true">404</code>
    <p class="kicker">// unreachable ref</p>
    <h1>That page is not in this workbench.</h1>
    <p class="section-lead" style="margin-bottom: 1.9rem;">
      The link may point at a page that was never committed. Head back to the homepage for the
      tour, features, downloads, and latest release notes.
    </p>
    <div class="not-found-actions">
      <a class="button button-primary" href="/">Back to the homepage</a>
      <a class="button button-outline" href="/#download">Get the app</a>
    </div>
  </section>
</BaseLayout>
