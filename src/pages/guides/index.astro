---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContentCards from '../../components/ContentCards.astro';
import { GUIDE_PAGES } from '../../data/content';
import { PAGE_META } from '../../data/pages';
import { pageSchema } from '../../data/schema';
const meta = PAGE_META.guides;
const breadcrumbs = [{label:'Home',href:'/'},{label:'Guides',href:meta.path}];
---
<BaseLayout title={meta.title} description={meta.description} structuredData={pageSchema(meta.path,meta.title,meta.description,breadcrumbs,'CollectionPage')}>
  <PageHeader eyebrow="the field guides" heading="A good place to get your bearings." lead="Install the app, make a first commit, or take a closer look at an advanced workflow. Practical guides drawn from the project's maintained documentation." breadcrumbs={breadcrumbs} />
  <section class="wrap page-content" aria-labelledby="guides-heading"><h2 class="collection-heading" id="guides-heading">Choose your next step</h2><ContentCards items={GUIDE_PAGES.map((page)=>({label:page.label,description:page.description,href:`/guides/${page.slug}/`}))} /></section>
  <section class="wrap capability-band"><div><p class="kicker">Help inside the app</p><h2>Keep learning where you work.</h2><p>Home → Explore Git Workbench opens the built-in guide with 28 topics. Search instructions, follow related topics, and open the relevant settings or repository tool from the guide.</p></div><div><a class="text-link" href="/faq/">Read frequently asked questions →</a><a class="text-link" href="/features/">Explore the product features →</a></div></section>
</BaseLayout>
