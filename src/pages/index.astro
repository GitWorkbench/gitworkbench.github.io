---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HistoryReplayDemo from '../components/HistoryReplayDemo.astro';
import Features from '../components/Features.astro';
import Tour from '../components/Tour.astro';
import ThemeGallery from '../components/ThemeGallery.astro';
import Workflow from '../components/Workflow.astro';
import Downloads from '../components/Downloads.astro';
import Faq from '../components/Faq.astro';
import OpenSource from '../components/OpenSource.astro';
import { SITE, THEMES } from '../data/site';
import { softwareSchema, faqSchema } from '../data/schema';

const absolute = (path: string) => new URL(path, SITE.url).href;

const structuredData = [
  softwareSchema,
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    name: SITE.name,
    alternateName: 'GitWorkbench',
    url: SITE.url,
    inLanguage: 'en',
    description: SITE.description,
    publisher: {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      url: SITE.url,
      sameAs: ['https://github.com/GitWorkbench/'],
      logo: {
        '@type': 'ImageObject',
        url: absolute('/assets/icon.png'),
      },
    },
  },
  faqSchema,
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${SITE.name} theme palettes`,
    itemListElement: THEMES.map((theme, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: theme.name,
    })),
  },
];
---

<BaseLayout title={SITE.title} description={SITE.description} structuredData={structuredData}>
  <Hero />
  <HistoryReplayDemo />
  <Features />
  <Tour />
  <ThemeGallery />
  <Workflow />
  <Downloads />
  <Faq />
  <OpenSource />
</BaseLayout>
