---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContentCards from '../../components/ContentCards.astro';
import { COMPARISONS } from '../../data/comparisons';
import { PAGE_META } from '../../data/pages';
import { pageSchema, absolute } from '../../data/schema';
const meta = PAGE_META.compare;
const breadcrumbs = [{label:'Home',href:'/'},{label:'Compare Git clients',href:meta.path}];
const items = COMPARISONS.map((page)=>({label:`${page.competitor} alternative`,description:page.description,href:`/compare/${page.slug}/`}));
const structuredData = [...pageSchema(meta.path,meta.title,meta.description,breadcrumbs,'CollectionPage'),{'@context':'https://schema.org','@type':'ItemList',name:'Git Workbench client comparisons',itemListElement:items.map((item,index)=>({'@type':'ListItem',position:index+1,name:item.label,url:absolute(item.href)}))}];
---
<BaseLayout title={meta.title} description={meta.description} structuredData={structuredData}>
  <PageHeader eyebrow="compare Git clients" heading="Choose the client that fits your work." lead="Compare Git Workbench with GitKraken, Sourcetree, GitHub Desktop, Fork, and SmartGit. Start with platform support, licensing, and the workflows you need every day." breadcrumbs={breadcrumbs} />
  <section class="wrap page-content" aria-labelledby="comparisons-heading"><h2 class="collection-heading" id="comparisons-heading">Explore the alternatives</h2><ContentCards items={items} /></section>
  <section class="wrap capability-band"><div><p class="kicker">A useful comparison starts here</p><h2>Bring your actual requirements.</h2><p>Check your desktop platform, repository host, license requirements, and any enterprise connection before switching. Each page links to official sources, includes a review date, and explains where another tool may fit better.</p></div><div><a class="text-link" href="/features/">Explore Git Workbench’s features →</a><a class="text-link" href="/download/">Check packages and platform details →</a><a class="text-link" href="/guides/getting-started/">Plan your first run →</a></div></section>
</BaseLayout>
