---
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContentCards from '../components/ContentCards.astro';
import { COMPARISONS, type Comparison } from '../data/comparisons';
import { pageSchema } from '../data/schema';
interface Props { comparison: Comparison }
const { comparison: item } = Astro.props;
const path = `/compare/${item.slug}/`;
const breadcrumbs = [{label:'Home',href:'/'},{label:'Compare Git clients',href:'/compare/'},{label:`${item.competitor} alternative`,href:path}];
const reviewed = new Intl.DateTimeFormat('en', {day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(`${item.reviewedOn}T00:00:00Z`));
const related = COMPARISONS.filter((candidate)=>candidate.slug !== item.slug).slice(0,2);
---
<BaseLayout title={item.title} description={item.description} structuredData={pageSchema(path,item.title,item.description,breadcrumbs)}>
  <PageHeader eyebrow="compare your options" heading={item.heading} lead={item.lead} breadcrumbs={breadcrumbs}>
    <div class="page-actions"><a class="button button-primary" href="/download/">Try Git Workbench <span aria-hidden="true">↓</span></a><a class="text-link" href="/compare/">Compare other Git clients →</a></div>
    <p class="comparison-reviewed">Sources checked <time datetime={item.reviewedOn}>{reviewed}</time> <span aria-hidden="true">·</span> An independent comparison by Git Workbench</p>
  </PageHeader>
  <div class="wrap document-layout">
    <aside class="document-toc"><nav aria-label="On this page"><p>On this page</p><ol>
      <li><a href="#overview">The choice in context</a></li>
      <li><a href="#comparison">Side-by-side comparison</a></li>
      <li><a href="#consider-workbench">Why consider Git Workbench</a></li>
      <li><a href="#other-fit">When {item.competitor} may fit better</a></li>
      <li><a href="#before-switching">Before you switch</a></li>
      <li><a href="#sources">Sources and review date</a></li>
    </ol></nav></aside>
    <article class="document-body comparison-body" aria-label={`Git Workbench and ${item.competitor} comparison`}>
      <section id="overview"><h2>The choice in context</h2><p>{item.context} <a class="comparison-citation" href={`#source-${item.contextSource + 1}`} aria-label={`Source ${item.contextSource + 1}: ${item.sources[item.contextSource].label}`}>[{item.contextSource + 1}]</a></p></section>
      <section id="comparison">
        <h2>Git Workbench vs {item.competitor}</h2>
        <p class="comparison-scroll-hint">Scroll sideways to compare both clients →</p>
        <div class="comparison-table" role="region" tabindex="0" aria-label={`Git Workbench vs ${item.competitor}: scrollable comparison table`}>
          <table>
            <caption class="visually-hidden">Documented platform, licensing, and workflow differences between Git Workbench and {item.competitor}.</caption>
            <thead><tr><th scope="col">What matters</th><th scope="col">Git Workbench</th><th scope="col">{item.competitor}</th></tr></thead>
            <tbody>{item.rows.map((row)=><tr><th scope="row">{row.topic}</th><td>{row.workbench}</td><td>{row.other} <a class="comparison-citation" href={`#source-${row.source + 1}`} aria-label={`Source ${row.source + 1}: ${item.sources[row.source].label}`}>[{row.source + 1}]</a></td></tr>)}</tbody>
          </table>
        </div>
        <p class="comparison-table-note">Platform and plan details can change. Check the linked official sources before making a decision.</p>
      </section>
      <section id="consider-workbench"><h2>Why consider Git Workbench?</h2><div class="comparison-reasons">{item.reasons.map((reason)=><div><h3>{reason.title}</h3><p>{reason.text}</p><a class="text-link" href={reason.href}>See how it works →</a></div>)}</div></section>
      <section id="other-fit"><h2>When {item.competitor} may fit better</h2><p>{item.otherFit} <a class="comparison-citation" href={`#source-${item.otherFitSource + 1}`} aria-label={`Source ${item.otherFitSource + 1}: ${item.sources[item.otherFitSource].label}`}>[{item.otherFitSource + 1}]</a></p></section>
      <section id="before-switching"><h2>Before you switch</h2><ul>{item.limits.map((limit)=><li>{limit}</li>)}</ul><p>Finish any active Git operation in your existing client, keep a backup of work that Git does not track, and open the local repository in Git Workbench. Configure its commit profile and optional providers separately; no repository-format conversion is needed.</p><div class="page-actions"><a class="text-link" href="/guides/getting-started/">First-run guide →</a><a class="text-link" href="/features/">Explore all features →</a></div></section>
      <footer id="sources" class="document-sources"><h2>Sources and review date</h2><p>Checked on <time datetime={item.reviewedOn}>{reviewed}</time>. Competitor statements above cite official product documentation; Git Workbench capabilities are documented in its application README. No performance benchmark or feature-parity claim is implied.</p><ol>{item.sources.map((source,index)=><li id={`source-${index + 1}`}><a href={source.href}>{source.label} <span aria-hidden="true">↗</span></a></li>)}</ol><p>{item.competitor} is a third-party product. This independent comparison does not imply affiliation, sponsorship, or endorsement. Third-party names and trademarks belong to their respective owners.</p></footer>
    </article>
  </div>
  <section class="related-content wrap" aria-labelledby="compare-next-heading"><p class="kicker">Keep comparing</p><h2 id="compare-next-heading">Find the workflow that fits.</h2><ContentCards compact items={related.map((page)=>({label:`${page.competitor} alternative`,description:page.description,href:`/compare/${page.slug}/`}))} /></section>
</BaseLayout>
