---
import { Picture } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContentCards from '../components/ContentCards.astro';
import { FEATURE_PAGES, GUIDE_PAGES, type ContentPage } from '../data/content';
import { pageSchema } from '../data/schema';
import history from '../assets/screenshots/history.jpg';
import diff from '../assets/screenshots/diff.jpg';
import merge from '../assets/screenshots/merge.jpg';
interface Props { page: ContentPage; category: 'features' | 'guides' }
const { page, category } = Astro.props;
const path = `/${category}/${page.slug}/`;
const breadcrumbs = [{label: 'Home', href: '/'}, {label: category === 'features' ? 'Features' : 'Guides', href: `/${category}/`}, {label: page.label, href: path}];
const pool = category === 'features' ? FEATURE_PAGES : GUIDE_PAGES;
const related = page.related.map((slug) => pool.find((candidate) => candidate.slug === slug)).filter((candidate): candidate is ContentPage => Boolean(candidate));
const screenshots = {
  history: { src: history, alt: 'Git Workbench commit graph with colored branches, inline references, commit summaries, and selected commit details.' },
  diff: { src: diff, alt: 'Git Workbench diff viewer with changed repository files and a side-by-side patch for reviewing and staging changes.' },
  merge: { src: merge, alt: 'Git Workbench merge conflict editor showing read-only Current and Incoming panes alongside the editable Merge result.' },
};
const shot = page.screenshot ? screenshots[page.screenshot] : null;
const image = page.screenshot ? `/assets/screenshots/${page.screenshot}.jpg` : undefined;
---
<BaseLayout title={page.title} description={page.description} canonicalPath={path} image={image} imageAlt={shot?.alt} type={category === 'guides' ? 'article' : 'website'} structuredData={pageSchema(path, page.title, page.description, breadcrumbs, category === 'guides' ? 'TechArticle' : 'WebPage')}>
  <PageHeader eyebrow={category === 'guides' ? 'field guide' : 'inside the workbench'} heading={page.heading} lead={page.lead} breadcrumbs={breadcrumbs}>
    <div class="page-actions"><a class="button button-primary" href="/download/">Get Git Workbench <span aria-hidden="true">↓</span></a><a class="text-link" href={`/${category}/`}>All {category} <span aria-hidden="true">→</span></a></div>
  </PageHeader>
  {shot && <figure class="article-screenshot wrap"><Picture src={shot.src} alt={shot.alt} widths={[480, 720, 1080, 1440]} sizes="(max-width: 880px) calc(100vw - 40px), 1000px" formats={['avif','webp']} quality={82} loading="lazy" /><figcaption>Captured from the desktop app using a fictional demo repository.</figcaption></figure>}
  <div class="wrap document-layout">
    <aside class="document-toc"><nav aria-label="On this page"><p>On this page</p><ol>{page.sections.map((section) => <li><a href={`#${section.id}`}>{section.title}</a></li>)}</ol></nav></aside>
    <article class="document-body" aria-label={page.label}>
      {page.sections.map((section) => (
        <section id={section.id}>
          <h2>{section.title}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          {section.items && (section.ordered ? <ol>{section.items.map((item) => <li>{item}</li>)}</ol> : <ul>{section.items.map((item) => <li>{item}</li>)}</ul>)}
          {section.code && <pre tabindex="0" aria-label={`${section.title}: command example`}><code>{section.code}</code></pre>}
          {section.note && <aside class="document-note"><p>{section.note}</p></aside>}
        </section>
      ))}
      <footer class="document-sources"><h2>Source documentation</h2><p>These guides explain the capabilities and limits documented in the project. For the full technical detail, read the maintained sources.</p><ul>{page.sources.map((source) => <li><a href={source.href}>{source.label} <span aria-hidden="true">↗</span></a></li>)}</ul></footer>
    </article>
  </div>
  <section class="related-content wrap" aria-labelledby="related-heading"><p class="kicker">Keep exploring</p><h2 id="related-heading">The next part of your workflow.</h2><ContentCards compact items={related.map((item) => ({label: item.label, description: item.description, href: `/${category}/${item.slug}/`}))} /></section>
</BaseLayout>
